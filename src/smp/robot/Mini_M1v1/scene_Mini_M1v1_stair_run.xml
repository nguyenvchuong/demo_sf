<mujoco model="minim1 stair scene">
  <include file="Mini_M1v1.xml"/>

  <statistic center="3.0 0.0 0.3" extent="3.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="stair" rgba="0.55 0.55 0.6 1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <!-- Ground at z=0: the robot spawns at the origin standing on the floor. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      friction="1.0 0.01 0.001"/>

    <!-- Symmetric staircase sitting ON the floor, centered on y=0 (the robot's
         line) and placed 2 m in front of the robot: nearest step edge at x=2.0.
         Ascends in +x (3 steps × 0.15 m) to a 1.5 m-deep platform at z=0.60,
         then descends symmetrically. Each box is filled from the floor up to its
         tread; all steps are 1.2 m wide (y). -->
    <body name="stairs" pos="0 0 0">
      <!-- ascent (near side, facing the robot): edge at x=2.0 -->
      <geom name="stair_up_1" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="2.25 0 0.075" size="0.25 0.6 0.075"/>  <!-- tread z=0.15, x[2.00,2.50] -->
      <geom name="stair_up_2" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="2.75 0 0.150" size="0.25 0.6 0.150"/>  <!-- tread z=0.30, x[2.50,3.00] -->
      <geom name="stair_up_3" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="3.25 0 0.225" size="0.25 0.6 0.225"/>  <!-- tread z=0.45, x[3.00,3.50] -->

      <!-- top platform: tread z=0.60, 1.5 m deep, x[3.50,5.00] -->
      <geom name="stair_top" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="4.25 0 0.300" size="0.75 0.6 0.300"/>

      <!-- descent (far side, mirror of the ascent about the platform center) -->
      <geom name="stair_down_3" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="5.25 0 0.225" size="0.25 0.6 0.225"/>  <!-- tread z=0.45, x[5.00,5.50] -->
      <geom name="stair_down_2" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="5.75 0 0.150" size="0.25 0.6 0.150"/>  <!-- tread z=0.30, x[5.50,6.00] -->
      <geom name="stair_down_1" type="box" material="stair" friction="1.0 0.01 0.001"
        pos="6.25 0 0.075" size="0.25 0.6 0.075"/>  <!-- tread z=0.15, x[6.00,6.50] -->
    </body>
  </worldbody>
</mujoco>
